{
  "v": 1,
  "claim": "Without an API key, the resolve-library-id tool finds the Context7 library ID for a library name, here React.",
  "subject": {
    "kind": "mcp-stdio",
    "name": "Context7 MCP",
    "package": "@upstash/context7-mcp",
    "version": "4.6.0"
  },
  "steps": [
    {
      "tool": "resolve-library-id",
      "arguments": {
        "libraryName": "react",
        "query": "react hooks"
      },
      "expect": {
        "contains": "Context7-compatible library ID: /"
      }
    }
  ],
  "tags": [
    "mcp",
    "docs",
    "libraries",
    "needs-network"
  ]
}
