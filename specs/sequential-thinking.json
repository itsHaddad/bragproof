{
  "v": 1,
  "claim": "The sequentialthinking tool records a thought and reports its number and the length of the thought history.",
  "subject": {
    "kind": "mcp-stdio",
    "name": "MCP Sequential Thinking server",
    "package": "@modelcontextprotocol/server-sequential-thinking",
    "version": "2.1.1"
  },
  "steps": [
    {
      "tool": "sequentialthinking",
      "arguments": {
        "thought": "Check that this tool answers.",
        "nextThoughtNeeded": false,
        "thoughtNumber": 1,
        "totalThoughts": 1
      },
      "expect": {
        "contains": "\"thoughtHistoryLength\": 1"
      }
    }
  ],
  "tags": [
    "mcp",
    "reference",
    "reasoning"
  ]
}
