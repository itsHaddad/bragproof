{
  "v": 1,
  "claim": "The echo tool returns the message it was given, prefixed with 'Echo: '.",
  "subject": {
    "kind": "mcp-stdio",
    "name": "mcp-echo-server",
    "package": "mcp-echo-server",
    "version": "1.0.0"
  },
  "steps": [
    {
      "tool": "echo",
      "arguments": {
        "message": "bragproof-7f3a"
      },
      "expect": {
        "equals": "Echo: bragproof-7f3a"
      }
    }
  ],
  "tags": [
    "mcp",
    "testing"
  ]
}
