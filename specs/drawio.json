{
  "v": 1,
  "claim": "The server searches the draw.io shape library by keyword, returning style strings, and returns a Mermaid reference for diagram generation.",
  "subject": {
    "kind": "mcp-stdio",
    "name": "draw.io MCP server",
    "package": "@drawio/mcp",
    "version": "1.12.0"
  },
  "steps": [
    {
      "tool": "search_shapes",
      "arguments": {
        "query": "cloud",
        "limit": 3
      },
      "expect": {
        "contains": "\"style\""
      }
    },
    {
      "tool": "get_drawio_reference",
      "arguments": {
        "format": "mermaid"
      },
      "expect": {
        "contains": "# Mermaid Reference"
      }
    }
  ],
  "tags": [
    "mcp",
    "diagrams",
    "drawio"
  ]
}
