{
  "v": 1,
  "claim": "The get-npm-package-details tool returns the name, description and latest version of an npm package.",
  "subject": {
    "kind": "mcp-stdio",
    "name": "Package Registry MCP",
    "package": "package-registry-mcp",
    "version": "2.1.0"
  },
  "steps": [
    {
      "tool": "get-npm-package-details",
      "arguments": {
        "name": "left-pad"
      },
      "expect": {
        "contains": "\"name\": \"left-pad\""
      }
    }
  ],
  "tags": [
    "mcp",
    "npm",
    "packages",
    "needs-network"
  ]
}
