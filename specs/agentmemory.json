{
  "v": 1,
  "claim": "With no server running, the tools save a memory to local storage and find it again by searching for a word in it.",
  "subject": {
    "kind": "mcp-stdio",
    "name": "agentmemory MCP",
    "package": "@agentmemory/mcp",
    "version": "0.9.33"
  },
  "steps": [
    {
      "tool": "memory_save",
      "arguments": {
        "content": "bragproof-7f3a is a test note"
      },
      "expect": {
        "contains": "\"saved\""
      }
    },
    {
      "tool": "memory_recall",
      "arguments": {
        "query": "bragproof-7f3a"
      },
      "expect": {
        "matches": "\"matched_count\": [1-9]"
      }
    }
  ],
  "tags": [
    "mcp",
    "memory",
    "agents"
  ]
}
