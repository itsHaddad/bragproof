{
  "v": 1,
  "claim": "The client.and tool returns the last value when all are truthy, and client.not negates a boolean.",
  "subject": {
    "kind": "mcp-stdio",
    "name": "Procedures MCP dev tools",
    "package": "@procedures/mcp-dev-tools",
    "version": "0.55.0"
  },
  "steps": [
    {
      "tool": "client.and",
      "arguments": {
        "values": [
          true,
          "bragproof"
        ]
      },
      "expect": {
        "equals": "bragproof"
      }
    },
    {
      "tool": "client.not",
      "arguments": {
        "value": false
      },
      "expect": {
        "equals": "true"
      }
    }
  ],
  "tags": [
    "mcp",
    "logic",
    "testing"
  ]
}
