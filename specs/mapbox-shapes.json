{
  "v": 1,
  "claim": "Without a Mapbox access token, the server computes the area, centroid and bounding box of a polygon and simplifies a line.",
  "subject": {
    "kind": "mcp-stdio",
    "name": "Mapbox MCP server",
    "package": "@mapbox/mcp-server",
    "version": "0.18.0"
  },
  "steps": [
    {
      "tool": "area_tool",
      "arguments": {
        "geometry": [
          [
            [
              0,
              0
            ],
            [
              1,
              0
            ],
            [
              1,
              1
            ],
            [
              0,
              1
            ],
            [
              0,
              0
            ]
          ]
        ],
        "units": "kilometers"
      },
      "expect": {
        "contains": "Area: 12363.718 square kilometers"
      }
    },
    {
      "tool": "centroid_tool",
      "arguments": {
        "geometry": [
          [
            [
              0,
              0
            ],
            [
              1,
              0
            ],
            [
              1,
              1
            ],
            [
              0,
              1
            ],
            [
              0,
              0
            ]
          ]
        ]
      },
      "expect": {
        "contains": "Centroid: [0.5, 0.5]"
      }
    },
    {
      "tool": "bbox_tool",
      "arguments": {
        "geometry": [
          [
            [
              0,
              0
            ],
            [
              1,
              0
            ],
            [
              1,
              1
            ],
            [
              0,
              1
            ],
            [
              0,
              0
            ]
          ]
        ]
      },
      "expect": {
        "contains": "Bounding Box: [0, 0, 1, 1]"
      }
    },
    {
      "tool": "simplify_tool",
      "arguments": {
        "geometry": [
          [
            0,
            0
          ],
          [
            0.5,
            0.001
          ],
          [
            1,
            0
          ]
        ],
        "tolerance": 0.01
      },
      "expect": {
        "contains": "Simplified vertices: 2"
      }
    }
  ],
  "tags": [
    "mcp",
    "geo",
    "maps",
    "geometry"
  ]
}
