{
  "v": 1,
  "claim": "The list_items tool lists Mantine documentation items filtered by kind, here hooks.",
  "subject": {
    "kind": "mcp-stdio",
    "name": "Mantine MCP server",
    "package": "@mantine/mcp-server",
    "version": "9.8.0"
  },
  "steps": [
    {
      "tool": "list_items",
      "arguments": {
        "kind": "hook",
        "limit": 5
      },
      "expect": {
        "contains": "\"kind\": \"hook\""
      }
    }
  ],
  "tags": [
    "mcp",
    "mantine",
    "react",
    "docs"
  ]
}
