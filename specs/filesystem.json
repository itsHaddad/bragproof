{
  "v": 1,
  "claim": "Started with one allowed directory, the server lists it, writes a text file there and reads the same text back.",
  "subject": {
    "kind": "mcp-stdio",
    "name": "MCP Filesystem server",
    "package": "@modelcontextprotocol/server-filesystem",
    "version": "2.3.0",
    "args": [
      "/tmp"
    ]
  },
  "steps": [
    {
      "tool": "list_allowed_directories",
      "arguments": {},
      "expect": {
        "contains": "/tmp"
      }
    },
    {
      "tool": "write_file",
      "arguments": {
        "path": "/tmp/bragproof.txt",
        "content": "bragproof-7f3a"
      },
      "expect": {
        "contains": "Successfully wrote"
      }
    },
    {
      "tool": "read_text_file",
      "arguments": {
        "path": "/tmp/bragproof.txt"
      },
      "expect": {
        "equals": "bragproof-7f3a"
      }
    }
  ],
  "tags": [
    "mcp",
    "reference",
    "files"
  ]
}
