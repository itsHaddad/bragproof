{
  // The public Bragproof feed. Deploy: bunx wrangler deploy
  "name": "bragproof-feed",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "bragproof.smaverk.com", "custom_domain": true }],
  "vars": { "PUBLIC_ORIGIN": "https://bragproof.smaverk.com" },
  "d1_databases": [{ "binding": "DB", "database_name": "bragproof-feed", "database_id": "TO-BE-CREATED" }],
  "observability": { "enabled": true }
}
