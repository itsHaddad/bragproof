{
  // The public site. Static files only: no server code, no database, no bindings.
  // Deploying this replaces what bragproof.smaverk.com serves. Deploy: bun run build && bunx wrangler deploy
  "name": "bragproof-feed",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "routes": [{ "pattern": "bragproof.smaverk.com", "custom_domain": true }],
  "assets": { "directory": "dist", "html_handling": "auto-trailing-slash", "not_found_handling": "404-page" },
  "observability": { "enabled": false }
}
