{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": { "enabled": false },
  "files": { "includes": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts", "worker/**/*.ts", "examples/**/*.ts"] },
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      // JSON-RPC messages and token claims are untyped JSON at the door; they are checked field by field
      "suspicious": { "noExplicitAny": "off", "noAssignInExpressions": "off" },
      "style": { "noNonNullAssertion": "off", "useTemplate": "off" }
    }
  }
}
